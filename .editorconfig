root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
# 120-col is our aspiration (AGENTS.md); the KTLINT RULE is disabled because no local
# ktlint runner exists in the authoring sandbox to verify conformance, and the rule is
# not auto-fixable by ktlintFormat. Everything else in ktlint's standard set is enforced.
max_line_length = 120
ktlint_standard_max-line-length = disabled

[*.{yaml,yml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
